{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(.venv/bin/donate:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh api rate_limit:*)",
      "Bash(gh search:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "ask": [
      "Bash(*--live*)",
      "Bash(gh api -X:*)",
      "Bash(gh api --method:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr review:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Read(./.env)"
    ]
  }
}
